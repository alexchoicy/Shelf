{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "JWT": {
    "Issuer": "Shelf.Api",
    "Audience": "Shelf.Client"
  },
  "Storage": {
    "DefaultProvider": "S3",
    "Local": {
      "RootPath": "./data/files",
      "BaseUrl": "http://localhost:5143/files"
    },
    "S3": {
      "Bucket": "shelf-bucket",
      "Region": "us-east-1",
      "Endpoint": "",
      "UsePathStyle": false,
      "BasePath": "shelf"
    },
    "MediaFolders": {
      "Original": "media/original",
      "Transcode": "media/transcode",
      "Thumbnail": "media/thumbnail",
      "Preview": "media/preview",
      "Cover": "media/cover",
      "Other": "other"
    }
  }
}
